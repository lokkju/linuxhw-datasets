# Cloudflare R2 Configuration
# Copy to .env and fill in your credentials

# Cloudflare account ID (find in dashboard URL or API settings)
R2_ACCOUNT_ID=your_account_id

# R2 API credentials (create at: Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# R2 bucket name
R2_BUCKET=roaringbuckets

# Base path within the bucket (no leading/trailing slashes)
# Example: datasets/linuxhw/edid
R2_BASE_PATH=datasets/linuxhw/edid

# Public URL for the bucket (optional, for display only)
# Used to show URLs after upload completes
R2_PUBLIC_URL=https://roaringbuckets.placist.org

# Cloudflare cache purge (optional)
# Required to purge /latest/ paths when updating
# Create token at: Cloudflare Dashboard > domain > API Tokens
# Permissions needed: Zone > Cache Purge > Purge
CF_ZONE_ID=your_zone_id
CF_API_TOKEN=your_api_token
