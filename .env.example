# Cloudflare R2 Configuration
# Copy to .env and fill in your credentials

# Cloudflare account ID (find in dashboard URL or API settings)
R2_ACCOUNT_ID=your_account_id

# R2 API credentials (create at: Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# R2 bucket name
R2_BUCKET=linuxhw-datasets

# Public URL for the bucket (optional)
# If using R2.dev subdomain: https://pub-{hash}.r2.dev
# If using custom domain: https://data.example.com
R2_PUBLIC_URL=https://pub-xxx.r2.dev
